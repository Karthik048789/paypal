# ========================================================
# PayGuard Escrow - Unified Environment Configuration
# ========================================================

# Member A: PayPal Escrow & Payments Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Member B: Cloud Browser & Agent Configuration
KERNEL_API_KEY=
# e.g. wss://<your-kernel-browser-host>/cdp
KERNEL_CDP_ENDPOINT=
LLM_API_KEY=
# e.g. a Gemini or OpenAI model name
LLM_MODEL=

# Worker & Queue Configuration
# e.g. redis://<host>:<port>
REDIS_URL=

# App & Local Ports
PORT=3000
DEMO_PORT=4100
ALLOW_LOCALHOST=true

